flowchart LR
  %% Azure control plane & infra
  subgraph Azure[Azure]
    direction TB
    ACR["Azure Container Registry<br>modules_acr_bicep / acr_role_assignment"]
    AKS["Azure Kubernetes Service<br>modules_aks_bicep / aks_rbac_assignment"]
    KV["Azure Key Vault<br>modules_keyvault_bicep / keyvault_role_assignment"]
    DBs["(Datastores)<br>CosmosDB + PostgreSQL<br>modules_cosmosdb_postgresql"]
    PIP["Public IP & DNS<br>modules_ingress_dnslabel"]
    MI["Managed Identities<br>base_identity / base_admin_identity"]
    GHA["GitHub Actions OIDC Identity<br>modules_gha_oidc_identity"]
  end

  %% Kubernetes logical components
  subgraph AKSCluster["AKS Cluster - k8s"]
    direction TB
    Ingress["Ingress Controller<br>k8s_ingress"]
    CertManager["Cert-Manager<br>k8s_cert_manager (LetsEncrypt)"]
    CSI["Secrets Store CSI Driver<br>k8s_secret_provider_class"]
    App["Application Deployment<br>k8s_deployment / k8s_service"]
    Headless["Headless Service<br>k8s_headless_service"]
  end

  %% CI/CD flows
  GHA -->|push images & deploy| ACR
  GHA -->|deploy manifests / az cli| AKS

  %% runtime flows
  ACR -->|image pull| AKS
  AKS -->|uses Managed Identity| MI
  MI -->|access & RBAC| KV
  KV -->|secrets via CSI| CSI
  CSI -->|mount secrets| App

  %% networking & TLS
  PIP -->|public endpoint / DNS| Ingress
  Ingress -->|routes traffic| App
  CertManager -->|issue TLS certs| Ingress

  %% data layer
  App -->|reads/writes| DBs

  %% role assignments & infra glue (annotations)
  ACR -. role assignment .-> AKS
  AKS -. role assignment .-> KV

  style Azure fill:#f8f9fb,stroke:#ccc
  style AKSCluster fill:#eef6ff,stroke:#9fc5ff
