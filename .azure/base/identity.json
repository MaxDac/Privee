{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "8501737010664013077"
    }
  },
  "parameters": {
    "identityName": {
      "type": "string",
      "metadata": {
        "description": "Name for the User Managed Identity"
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for the identity resource"
      }
    },
    "githubOwner": {
      "type": "string",
      "metadata": {
        "description": "GitHub repository owner"
      }
    },
    "githubRepo": {
      "type": "string",
      "metadata": {
        "description": "GitHub repository name"
      }
    },
    "oidcSubject": {
      "type": "string",
      "metadata": {
        "description": "OIDC subject for GitHub Actions authentication"
      }
    },
    "environment": {
      "type": "string",
      "metadata": {
        "description": "Environment name for tagging"
      }
    }
  },
  "variables": {
    "issuer": "https://token.actions.githubusercontent.com",
    "subject": "[format('repo:{0}/{1}:{2}', parameters('githubOwner'), parameters('githubRepo'), parameters('oidcSubject'))]",
    "audience": "api://AzureADTokenExchange",
    "federatedCredentialName": "github-actions-admin"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('identityName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Purpose": "GitHub Actions Administrative Identity",
        "Environment": "[parameters('environment')]",
        "Repository": "[format('{0}/{1}', parameters('githubOwner'), parameters('githubRepo'))]",
        "Subject": "[parameters('oidcSubject')]"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}/{1}', parameters('identityName'), variables('federatedCredentialName'))]",
      "properties": {
        "issuer": "[variables('issuer')]",
        "subject": "[variables('subject')]",
        "audiences": [
          "[variables('audience')]"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
      ]
    }
  ],
  "outputs": {
    "clientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]"
    },
    "identityResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
    },
    "federatedSubject": {
      "type": "string",
      "value": "[variables('subject')]"
    }
  }
}