{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "11848402739557709530"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "metadata": {
        "description": "Prefix for resource names (letters/numbers only)."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "githubOwner": {
      "type": "string",
      "metadata": {
        "description": "GitHub organization or user that owns the repository"
      }
    },
    "githubRepo": {
      "type": "string",
      "metadata": {
        "description": "GitHub repository name"
      }
    },
    "oidcSubject": {
      "type": "string",
      "defaultValue": "ref:refs/heads/main",
      "metadata": {
        "description": "OIDC subject for GitHub Actions authentication (e.g., ref:refs/heads/main)"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Environment name (dev, staging, prod)"
      }
    },
    "identityResourceGroupName": {
      "type": "string",
      "defaultValue": "[format('{0}-identity-rg', parameters('namePrefix'))]",
      "metadata": {
        "description": "Resource group name for the identity resources"
      }
    }
  },
  "variables": {
    "contributorRoleId": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "adminIdentityName": "[toLower(format('{0}-gha-admin-{1}', parameters('namePrefix'), parameters('environment')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2023-07-01",
      "name": "[parameters('identityResourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Purpose": "GitHub Actions Identity",
        "Environment": "[parameters('environment')]",
        "ManagedBy": "Bicep"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, variables('adminIdentityName'), variables('contributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('contributorRoleId'))]",
        "principalId": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment'), '2022-09-01').outputs.principalId.value]",
        "principalType": "ServicePrincipal",
        "description": "[format('GitHub Actions resource management for {0} - Contributor role', parameters('githubRepo'))]"
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "admin-identity-deployment",
      "resourceGroup": "[parameters('identityResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "identityName": {
            "value": "[variables('adminIdentityName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "githubOwner": {
            "value": "[parameters('githubOwner')]"
          },
          "githubRepo": {
            "value": "[parameters('githubRepo')]"
          },
          "oidcSubject": {
            "value": "[parameters('oidcSubject')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "8501737010664013077"
            }
          },
          "parameters": {
            "identityName": {
              "type": "string",
              "metadata": {
                "description": "Name for the User Managed Identity"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location for the identity resource"
              }
            },
            "githubOwner": {
              "type": "string",
              "metadata": {
                "description": "GitHub repository owner"
              }
            },
            "githubRepo": {
              "type": "string",
              "metadata": {
                "description": "GitHub repository name"
              }
            },
            "oidcSubject": {
              "type": "string",
              "metadata": {
                "description": "OIDC subject for GitHub Actions authentication"
              }
            },
            "environment": {
              "type": "string",
              "metadata": {
                "description": "Environment name for tagging"
              }
            }
          },
          "variables": {
            "issuer": "https://token.actions.githubusercontent.com",
            "subject": "[format('repo:{0}/{1}:{2}', parameters('githubOwner'), parameters('githubRepo'), parameters('oidcSubject'))]",
            "audience": "api://AzureADTokenExchange",
            "federatedCredentialName": "github-actions-admin"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[parameters('identityName')]",
              "location": "[parameters('location')]",
              "tags": {
                "Purpose": "GitHub Actions Administrative Identity",
                "Environment": "[parameters('environment')]",
                "Repository": "[format('{0}/{1}', parameters('githubOwner'), parameters('githubRepo'))]",
                "Subject": "[parameters('oidcSubject')]"
              }
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}/{1}', parameters('identityName'), variables('federatedCredentialName'))]",
              "properties": {
                "issuer": "[variables('issuer')]",
                "subject": "[variables('subject')]",
                "audiences": [
                  "[variables('audience')]"
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ]
            }
          ],
          "outputs": {
            "clientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]"
            },
            "identityResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
            },
            "federatedSubject": {
              "type": "string",
              "value": "[variables('subject')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('identityResourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "clientId": {
      "type": "string",
      "metadata": {
        "description": "The Client ID of the User Managed Identity for GitHub Actions secrets"
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment'), '2022-09-01').outputs.clientId.value]"
    },
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "The Principal ID of the User Managed Identity"
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment'), '2022-09-01').outputs.principalId.value]"
    },
    "identityResourceId": {
      "type": "string",
      "metadata": {
        "description": "The Resource ID of the User Managed Identity"
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment'), '2022-09-01').outputs.identityResourceId.value]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "The name of the created resource group"
      },
      "value": "[parameters('identityResourceGroupName')]"
    },
    "federatedSubject": {
      "type": "string",
      "metadata": {
        "description": "The federated identity subject used for OIDC"
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('identityResourceGroupName')), 'Microsoft.Resources/deployments', 'admin-identity-deployment'), '2022-09-01').outputs.federatedSubject.value]"
    },
    "permissionsSummary": {
      "type": "object",
      "metadata": {
        "description": "Summary of permissions granted"
      },
      "value": {
        "subscription": "[subscription().subscriptionId]",
        "roles": [
          "Contributor"
        ],
        "scope": "Subscription",
        "description": "Resource management access for GitHub Actions deployment (create/delete resources and resource groups)"
      }
    }
  }
}