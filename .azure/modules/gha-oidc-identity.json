{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "16920948007359730838"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "metadata": {
        "description": "Prefix for resource names (letters/numbers)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "githubOwner": {
      "type": "string",
      "metadata": {
        "description": "GitHub organization or user that owns the repo"
      }
    },
    "githubRepo": {
      "type": "string",
      "metadata": {
        "description": "GitHub repository name"
      }
    },
    "oidcSubject": {
      "type": "string",
      "defaultValue": "ref:refs/heads/main",
      "metadata": {
        "description": "OIDC subject: e.g. ref:refs/heads/main, environment:prod, or pull_request"
      }
    },
    "acrResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group name where the ACR lives"
      }
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "ACR name (e.g., Privee)"
      }
    },
    "aksResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group name where the AKS cluster lives"
      }
    },
    "aksName": {
      "type": "string",
      "metadata": {
        "description": "AKS cluster name"
      }
    },
    "grantAksAccess": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether to grant AKS access to the identity."
      }
    },
    "aksKubeletIdentityObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optionally, provide the AKS kubelet managed identity objectId to attach ACR pull to the cluster (emulates az aks update --attach-acr). Leave empty to skip."
      }
    }
  },
  "variables": {
    "aksClusterUserRoleId": "4abbcc35-e782-43d8-92c5-2d3f1bd2253f",
    "aksRbacClusterAdminRoleId": "3498e952-d568-435e-9b2c-8d77e338d7f7",
    "uaiName": "[toLower(format('{0}-gha-oidc', parameters('namePrefix')))]",
    "issuer": "https://token.actions.githubusercontent.com",
    "subject": "[format('repo:{0}/{1}:{2}', parameters('githubOwner'), parameters('githubRepo'), parameters('oidcSubject'))]",
    "audience": "api://AzureADTokenExchange",
    "readerRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('uaiName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}/{1}', variables('uaiName'), 'github-actions')]",
      "properties": {
        "issuer": "[variables('issuer')]",
        "subject": "[variables('subject')]",
        "audiences": [
          "[variables('audience')]"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, 'reader', variables('uaiName'))]",
      "properties": {
        "roleDefinitionId": "[variables('readerRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-acr-assignments', variables('uaiName'))]",
      "resourceGroup": "[parameters('acrResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "acrName": {
            "value": "[parameters('acrName')]"
          },
          "principalObjectId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').principalId]"
          },
          "kubeletIdentityObjectId": {
            "value": "[parameters('aksKubeletIdentityObjectId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "4551742611331568400"
            }
          },
          "parameters": {
            "acrName": {
              "type": "string",
              "metadata": {
                "description": "ACR name"
              }
            },
            "principalObjectId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the principal to assign AcrPush to (e.g., UAMI principalId)"
              }
            },
            "kubeletIdentityObjectId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional kubelet identity objectId to grant AcrPull (attach-acr equivalent). Leave empty to skip."
              }
            }
          },
          "variables": {
            "acrPushRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8311e382-0749-4cb8-b61a-304f252e45ec')]",
            "acrPullRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', parameters('acrName'))]",
              "name": "[guid(format('{0}-acr-push-{1}', resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), parameters('principalObjectId')))]",
              "properties": {
                "roleDefinitionId": "[variables('acrPushRoleId')]",
                "principalId": "[parameters('principalObjectId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "condition": "[not(empty(parameters('kubeletIdentityObjectId')))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', parameters('acrName'))]",
              "name": "[guid(format('{0}-acr-pull-kubelet-{1}', resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), parameters('kubeletIdentityObjectId')))]",
              "properties": {
                "roleDefinitionId": "[variables('acrPullRoleId')]",
                "principalId": "[parameters('kubeletIdentityObjectId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
      ]
    },
    {
      "condition": "[parameters('grantAksAccess')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-aks-rbac', variables('uaiName'))]",
      "resourceGroup": "[parameters('aksResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "aksName": {
            "value": "[parameters('aksName')]"
          },
          "principalObjectId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').principalId]"
          },
          "roleDefinitionId": {
            "value": "[variables('aksRbacClusterAdminRoleId')]"
          },
          "roleName": {
            "value": "ClusterAdmin"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "522337740559285216"
            }
          },
          "parameters": {
            "aksName": {
              "type": "string",
              "metadata": {
                "description": "AKS cluster name"
              }
            },
            "principalObjectId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the principal to assign RBAC to (e.g., UAMI principalId or federated OIDC MI)"
              }
            },
            "roleDefinitionId": {
              "type": "string",
              "metadata": {
                "description": "Role definition ID for AKS (e.g., Azure Kubernetes Service RBAC Cluster Admin or Cluster User Role)"
              }
            },
            "roleName": {
              "type": "string",
              "defaultValue": "[parameters('roleDefinitionId')]",
              "metadata": {
                "description": "Optional: Human readable role name for better GUID generation"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.ContainerService/managedClusters/{0}', parameters('aksName'))]",
              "name": "[guid(format('{0}-{1}-{2}', resourceId('Microsoft.ContainerService/managedClusters', parameters('aksName')), parameters('roleName'), parameters('principalObjectId')))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionId'))]",
                "principalId": "[parameters('principalObjectId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
      ]
    },
    {
      "condition": "[parameters('grantAksAccess')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-aks-getcreds', variables('uaiName'))]",
      "resourceGroup": "[parameters('aksResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "aksName": {
            "value": "[parameters('aksName')]"
          },
          "principalObjectId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').principalId]"
          },
          "roleDefinitionId": {
            "value": "[variables('aksClusterUserRoleId')]"
          },
          "roleName": {
            "value": "ClusterUser"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "522337740559285216"
            }
          },
          "parameters": {
            "aksName": {
              "type": "string",
              "metadata": {
                "description": "AKS cluster name"
              }
            },
            "principalObjectId": {
              "type": "string",
              "metadata": {
                "description": "Object ID of the principal to assign RBAC to (e.g., UAMI principalId or federated OIDC MI)"
              }
            },
            "roleDefinitionId": {
              "type": "string",
              "metadata": {
                "description": "Role definition ID for AKS (e.g., Azure Kubernetes Service RBAC Cluster Admin or Cluster User Role)"
              }
            },
            "roleName": {
              "type": "string",
              "defaultValue": "[parameters('roleDefinitionId')]",
              "metadata": {
                "description": "Optional: Human readable role name for better GUID generation"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.ContainerService/managedClusters/{0}', parameters('aksName'))]",
              "name": "[guid(format('{0}-{1}-{2}', resourceId('Microsoft.ContainerService/managedClusters', parameters('aksName')), parameters('roleName'), parameters('principalObjectId')))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionId'))]",
                "principalId": "[parameters('principalObjectId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName'))]"
      ]
    }
  ],
  "outputs": {
    "clientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').clientId]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('uaiName')), '2023-01-31').principalId]"
    },
    "federatedSubject": {
      "type": "string",
      "value": "[variables('subject')]"
    }
  }
}