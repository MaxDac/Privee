{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "17193884528741453048"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "metadata": {
        "description": "Prefix for resource names (letters/numbers)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "vnetCidr": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "VNet CIDR"
      }
    },
    "aksSubnetCidr": {
      "type": "string",
      "defaultValue": "10.0.1.0/24",
      "metadata": {
        "description": "AKS subnet CIDR"
      }
    },
    "cosmosSubnetCidr": {
      "type": "string",
      "defaultValue": "10.0.3.0/24",
      "metadata": {
        "description": "CosmosDB PostgreSQL subnet CIDR"
      }
    },
    "dnsZoneName": {
      "type": "string",
      "metadata": {
        "description": "Public Azure DNS zone to host your app domain (e.g., example.com)."
      }
    },
    "subdomainLabel": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional subdomain label to create and delegate as a child DNS zone (e.g., \"app\"). When provided, this child zone will be used by AKS Web App Routing."
      }
    }
  },
  "variables": {
    "vnetName": "[format('{0}-vnet', parameters('namePrefix'))]",
    "aksSubnetName": "[format('{0}-aks-subnet', parameters('namePrefix'))]",
    "cosmosSubnetName": "[format('{0}-cosmos-subnet', parameters('namePrefix'))]",
    "cosmosPrivateDnsZoneName": "privatelink.postgres.cosmos.azure.com",
    "childZoneName": "[if(empty(parameters('subdomainLabel')), '', format('{0}.{1}', parameters('subdomainLabel'), parameters('dnsZoneName')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetCidr')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('aksSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('aksSubnetCidr')]"
            }
          },
          {
            "name": "[variables('cosmosSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('cosmosSubnetCidr')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}-cosmos-nsg', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-aks-to-cosmos-5432",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "sourceAddressPrefixes": [
                "[parameters('aksSubnetCidr')]"
              ],
              "destinationAddressPrefix": "*",
              "destinationPortRange": "5432"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('cosmosPrivateDnsZoneName')]",
      "location": "global"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('cosmosPrivateDnsZoneName'), format('{0}-cosmosdns-link', parameters('namePrefix')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('cosmosPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/dnsZones",
      "apiVersion": "2018-05-01",
      "name": "[parameters('dnsZoneName')]",
      "location": "global"
    },
    {
      "condition": "[not(empty(parameters('subdomainLabel')))]",
      "type": "Microsoft.Network/dnsZones",
      "apiVersion": "2018-05-01",
      "name": "[variables('childZoneName')]",
      "location": "global"
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
    },
    "vnetName": {
      "type": "string",
      "value": "[variables('vnetName')]"
    },
    "aksSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('aksSubnetName'))]"
    },
    "cosmosSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('cosmosSubnetName'))]"
    },
    "cosmosPrivateDnsZoneId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/privateDnsZones', variables('cosmosPrivateDnsZoneName'))]"
    },
    "publicDnsZoneId": {
      "type": "string",
      "value": "[if(empty(parameters('subdomainLabel')), resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName')), resourceId('Microsoft.Network/dnsZones', variables('childZoneName')))]"
    }
  }
}