    "ingressDns": {
      "condition": "[not(empty(parameters('ingressDnsLabel')))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "ingress-dnslabel",
      "subscriptionId": "[subscription().subscriptionId]",
      "resourceGroup": "[format('MC_{0}_{1}-aks_{2}', resourceGroup().name, parameters('namePrefix'), parameters('location'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "namePrefix": {
            "value": "[parameters('namePrefix')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "ingressDnsLabel": {
            "value": "[parameters('ingressDnsLabel')]"
          },
          "ingressPublicIpName": {
            "value": "[parameters('ingressPublicIpName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "8503509410953523164"
            }
          },
          "parameters": {
            "namePrefix": {
              "type": "string",
              "metadata": {
                "description": "Prefix for resource names (letters/numbers)."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location for all resources."
              }
            },
            "ingressDnsLabel": {
              "type": "string",
              "metadata": {
                "description": "DNS label to assign to the ingress Public IP (must be unique per region)."
              }
            },
            "ingressPublicIpName": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional explicit Public IP resource name to update. If empty, the module selects the first Public IP with an assigned IP and no DNS label, otherwise the first Public IP."
              }
            }
          },
          "variables": {
            "networkContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}-ingress-dns-mi', parameters('namePrefix'))]",
              "location": "[parameters('location')]"
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, 'NetworkContributor', format('{0}-ingress-dns-mi', parameters('namePrefix')))]",
              "properties": {
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-ingress-dns-mi', parameters('namePrefix'))), '2023-01-31').principalId]",
                "roleDefinitionId": "[variables('networkContributorRoleId')]",
                "principalType": "ServicePrincipal"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-ingress-dns-mi', parameters('namePrefix')))]"
              ]
            },
            {
              "type": "Microsoft.Resources/deploymentScripts",
              "apiVersion": "2020-10-01",
              "name": "[format('{0}-set-ingress-dnslabel', parameters('namePrefix'))]",
              "location": "[parameters('location')]",
              "kind": "AzureCLI",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-ingress-dns-mi', parameters('namePrefix'))))]": {}
                }
              },
              "properties": {
                "azCliVersion": "2.57.0",
                "timeout": "PT10M",
                "retentionInterval": "P1D",
                "environmentVariables": [
                  {
                    "name": "RG",
                    "value": "[resourceGroup().name]"
                  },
                  {
                    "name": "DNS_LABEL",
                    "value": "[parameters('ingressDnsLabel')]"
                  },
                  {
                    "name": "PIP_NAME",
                    "value": "[parameters('ingressPublicIpName')]"
                  }
                ],
                "scriptContent": "      set -e\n      echo \"Node RG: $RG\"\n\n      # Helper: join lines into space-delimited string\n      join_lines() {\n        tr '\\n' ' ' | xargs\n      }\n\n      # Poll for an ingress Public IP (exclude outbound LB public IPs)\n      # Up to ~15 minutes (90 x 10s)\n      for i in $(seq 1 90); do\n        echo \"[attempt $i] Inspecting load balancers and public IPs in $RG...\"\n\n        # Identify outbound LBs (those having outboundRules)\n        OUTBOUND_LB_IDS=$(az network lb list -g \"$RG\" --query \"[?length(outboundRules)>0].id\" -o tsv 2>/dev/null || true)\n        OUTBOUND_PIP_IDS=\"\"\n        if [ -n \"$OUTBOUND_LB_IDS\" ]; then\n          while IFS= read -r LB_ID; do\n            [ -z \"$LB_ID\" ] && continue\n            PIPS=$(az network lb show --ids \"$LB_ID\" --query \"frontendIPConfigurations[?publicIPAddress!=null].[].publicIPAddress.id\" -o tsv 2>/dev/null || true)\n            if [ -n \"$PIPS\" ]; then\n              OUTBOUND_PIP_IDS=$(printf \"%s\\n%s\" \"$OUTBOUND_PIP_IDS\" \"$PIPS\")\n            fi\n          done <<< \"$OUTBOUND_LB_IDS\"\n        fi\n\n        # Gather candidate PIPs: those associated to any LB frontend and not part of outbound LBs\n        CANDIDATE_IDS=$(az network public-ip list -g \"$RG\" --query \"[?ipConfiguration!=null].id\" -o tsv 2>/dev/null || true)\n        SELECTED_ID=\"\"\n\n        # Prefer PIPs whose name contains 'kubernetes' or 'ingress' or 'app-routing'\n        if [ -n \"$CANDIDATE_IDS\" ]; then\n          while IFS= read -r PID; do\n            [ -z \"$PID\" ] && continue\n            # Skip if belongs to outbound LB set\n            if echo \"$OUTBOUND_PIP_IDS\" | grep -q \"$PID\"; then\n              continue\n            fi\n            NAME=$(az network public-ip show --ids \"$PID\" --query name -o tsv 2>/dev/null || true)\n            if echo \"$NAME\" | grep -qiE 'kubernetes|ingress|app-routing'; then\n              SELECTED_ID=\"$PID\"\n              break\n            fi\n          done <<< \"$CANDIDATE_IDS\"\n        fi\n\n        # Fallback: pick the first non-outbound candidate if none matched by name\n        if [ -z \"$SELECTED_ID\" ] && [ -n \"$CANDIDATE_IDS\" ]; then\n          while IFS= read -r PID; do\n            [ -z \"$PID\" ] && continue\n            if echo \"$OUTBOUND_PIP_IDS\" | grep -q \"$PID\"; then\n              continue\n            fi\n            SELECTED_ID=\"$PID\"\n            break\n          done <<< \"$CANDIDATE_IDS\"\n        fi\n\n        # If parameter provided, override discovery\n        if [ -n \"$PIP_NAME\" ]; then\n          echo \"PIP_NAME provided via parameter: $PIP_NAME\"\n          SELECTED_ID=$(az network public-ip show -g \"$RG\" -n \"$PIP_NAME\" --query id -o tsv 2>/dev/null || true)\n        fi\n\n        if [ -n \"$SELECTED_ID\" ]; then\n          PIP_NAME=$(az network public-ip show --ids \"$SELECTED_ID\" --query name -o tsv)\n          echo \"Chosen Public IP resource: $PIP_NAME\"\n          break\n        fi\n\n        echo \"Waiting for ingress Public IP to be created (or attached) in $RG...\"\n        sleep 10\n      done\n\n      if [ -z \"$PIP_NAME\" ]; then\n        echo \"ERROR: Could not discover an ingress Public IP in resource group $RG. Ensure the Web App Routing add-on is enabled and the ingress Service has provisioned a public IP.\" >&2\n        exit 1\n      fi\n\n      # If the desired label already exists on another PIP in this RG, remove it there first\n      EXISTING_ON_OTHERS=$(az network public-ip list -g \"$RG\" \\\n        --query \"[?dnsSettings.domainNameLabel=='$DNS_LABEL' && name!='$PIP_NAME'].name\" -o tsv)\n      if [ -n \"$EXISTING_ON_OTHERS\" ]; then\n        echo \"Found label '$DNS_LABEL' on other Public IP(s): $EXISTING_ON_OTHERS; removing to free the name\"\n        for N in $EXISTING_ON_OTHERS; do\n          az network public-ip update -g \"$RG\" -n \"$N\" --remove dnsSettings.domainNameLabel >/dev/null || true\n        done\n      fi\n\n      echo \"Updating Public IP '$PIP_NAME' with DNS label: $DNS_LABEL\"\n      az network public-ip update -g \"$RG\" -n \"$PIP_NAME\" --dns-name \"$DNS_LABEL\" >/dev/null\n\n      FQDN=$(az network public-ip show -g \"$RG\" -n \"$PIP_NAME\" --query \"dnsSettings.fqdn\" -o tsv)\n      echo \"Ingress FQDN set to: $FQDN\"\n    "
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-ingress-dns-mi', parameters('namePrefix')))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, 'NetworkContributor', format('{0}-ingress-dns-mi', parameters('namePrefix'))))]"
              ]
            }
          ],
          "outputs": {
            "dnsLabel": {
              "type": "string",
              "value": "[parameters('ingressDnsLabel')]"
            }
          }
        }
      },
      "dependsOn": [
        "aks"
      ]
    },
