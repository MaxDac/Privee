{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ES2020",
    "target": "ES2020",
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.mjs"],
  // Excluding tests as vitest is giving compilation errors
  "exclude": [
    "node_modules",
    "vendor/topbar.js",
    "vendor/libsignal-wasm",
    "js/tests",
    "playwright-report",
    "test-results"
  ]
}
