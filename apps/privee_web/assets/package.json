{
  "scripts": {
    "format": "prettier --write --config ./.prettierrc .",
    "check:dev": "npm run format && tsc && eslint --fix --ext .js,.mjs . && vitest run",
    "check": "prettier --check . && tsc && ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.mjs . && npm test",
    "test": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest run --silent=true",
    "test:verbose": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest run --silent=false",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest --silent=false"
  },
  "dependencies": {
    "flowbite": "~3.1.2"
  },
  "devDependencies": {
    "@types/jsdom": "~21.1.7",
    "@types/node": "~22.13.8",
    "@typescript-eslint/parser": "~8.35.0",
    "eslint": "~9.29.0",
    "eslint-config-prettier": "~10.1.5",
    "eslint-plugin-jsdoc": "~51.2.3",
    "eslint-plugin-prettier": "~5.5.1",
    "fake-indexeddb": "~6.0.1",
    "flowbite-typography": "~1.0.5",
    "jsdom": "~26.1.0",
    "prettier": "~3.6.2",
    "typescript": "~5.8.3",
    "vitest": "~3.2.4"
  }
}
