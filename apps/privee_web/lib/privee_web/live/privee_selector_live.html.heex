<div
  id="privee-selector-screen-container"
  class="mx-auto sm:max-w-sm md:max-w-md"
  phx-hook="PriveeSelectorScreen"
>
  <.header class="text-center">
    Create a new Privee
    <:subtitle>
      Specify the session name you would like to chat with.
    </:subtitle>
  </.header>

  <.simple_form for={@form} id="privee_form" phx-change="validate" phx-submit="create">
    <.input
      field={@form[:session_name]}
      type="text"
      label="Session Name"
      placeholder="The session name you'd like to contact."
      required
    />

    <:actions>
      <.button phx-disable-with="Creating..." class="w-full">
        Start Privee <span aria-hidden="true">→</span>
      </.button>
    </:actions>
  </.simple_form>
</div>
