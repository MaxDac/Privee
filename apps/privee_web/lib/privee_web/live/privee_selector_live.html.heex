<Layouts.app
  flash={@flash}
  current_session={@current_session}
  navigate_to={@navigate_to}
  locale={@locale}
>
  <div
    id="privee-selector-screen-container"
    class="mx-auto sm:max-w-sm md:max-w-md"
    phx-hook="PriveeSelectorScreen"
    data-own-session-id={@current_session.id}
  >
    <.header class="text-center">
      {lgettext(@locale, "Create a new Privee")}
      <:subtitle>
        {lgettext(@locale, "Specify the session name you would like to chat with.")}
      </:subtitle>
    </.header>

    <.simple_form for={@form} id="privee_form" phx-change="validate" phx-submit="create">
      <.input
        field={@form[:session_name]}
        type="text"
        label={lgettext(@locale, "Session Name")}
        placeholder={lgettext(@locale, "The session name you'd like to contact.")}
        required
      />
      <:actions>
        <.button phx-disable-with={lgettext(@locale, "Creating...")} class="w-full">
          {lgettext(@locale, "Start Privee")} <span aria-hidden="true">→</span>
        </.button>
      </:actions>
    </.simple_form>

    <%!-- Client-rendered from this browser's IndexedDB: names and local hints never reach the server --%>
    <div id="local-conversations" phx-update="ignore"></div>
  </div>
</Layouts.app>
