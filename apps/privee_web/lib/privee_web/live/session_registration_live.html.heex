<Layouts.app
  flash={@flash}
  current_session={@current_session}
  navigate_to={@navigate_to}
  locale={@locale}
>
  <div class="mx-auto sm:max-w-sm md:max-w-md">
    <.header class="text-center">
      {lgettext(@locale, "Create a new session")}
      <:subtitle>
        {lgettext(@locale, "Want to reconnect with an existing session?")}
        <.link
          navigate={~p"/login"}
          class="font-semibold text-brand dark:text-brand-dark hover:underline"
        >
          {lgettext(@locale, "Sign in")}
        </.link>
      </:subtitle>

      <:description>
        {lgettext(
          @locale,
          "To register a session, choose a session name of at least 24 alphanumeric characters separated by hyphens, and a recovery phrase containing only letters, spaces and punctuation."
        )}
      </:description>
    </.header>

    <.simple_form
      for={@form}
      id="registration_form"
      phx-submit="save"
      phx-change="validate"
      phx-trigger-action={@trigger_submit}
      action={~p"/sessions/log_in?_action=registered"}
      method="post"
      phx-hook="RegistrationScreen"
    >
      <.error :if={@check_errors}>
        {lgettext(@locale, "Oops, something went wrong! Please check the errors below.")}
      </.error>

      <input
        :if={@target_session_code}
        type="hidden"
        name="target_session_code"
        value={@target_session_code}
      />
      <.input
        field={@form[:session_name]}
        type="search"
        label={lgettext(@locale, "Session Name")}
        placeholder={lgettext(@locale, "Write your own session name")}
        value={@form[:session_name].value || @automatic_session_name}
        phx-debounce="1000"
        required
      />
      <div class="inline-flex space-x-10">
        <.input
          field={@form[:is_quick]}
          type="toggle"
          label={lgettext(@locale, "Quick session")}
        />
        <.info_icon
          id="quick-session-info"
          locale={@locale}
          inline_description={lgettext(@locale, "What's this?")}
          short_description={
            lgettext(@locale, "Create a session quickly without a recovery phrase")
          }
          long_description={
            lgettext(
              @locale,
              "A quick session needs no recovery phrase. You can sign in only once; you will not be able to recover this session later."
            )
          }
        />
      </div>

      <.input
        :if={!quick_session?(@form)}
        field={@form[:recovery_phrase]}
        type="textarea"
        label={lgettext(@locale, "Recovery phrase")}
        placeholder={
          lgettext(
            @locale,
            "Write your preferred citation. This will be used to recover the session, so keep it saved."
          )
        }
        rows="5"
        phx-debounce="1000"
        required
      />
      <:actions>
        <.button
          phx-disable-with={lgettext(@locale, "Creating account...")}
          class="w-full"
          name="action"
          value="create"
        >
          {lgettext(@locale, "Create an account")}
        </.button>
      </:actions>
    </.simple_form>
  </div>
</Layouts.app>
