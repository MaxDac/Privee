<%!--
  The composer is intentionally not a LiveView form and the input has no `name`:
  plaintext must never be serialized to the server. The ChatScreen hook reads it,
  encrypts it and pushes only the ciphertext. Commands such as `:lock` run in the
  browser and are never sent.
--%>
<div id="chat-composer" class="relative flex items-center gap-2" phx-update="ignore">
  <ul
    id="chat-commands"
    hidden
    class="absolute bottom-full left-0 mb-2 w-full max-w-md rounded-lg border border-zinc-200 bg-white p-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-900"
  >
  </ul>

  <span
    id="chat-vim-mode"
    hidden
    class="shrink-0 font-mono text-xs text-zinc-500"
  ></span>
  <input
    id="chat-text"
    type="text"
    autocomplete="off"
    maxlength="4000"
    placeholder={lgettext(@locale, "Write your message here")}
    aria-label={lgettext(@locale, "Message")}
    data-client-placeholder="messagePlaceholder"
    data-client-label="messageLabel"
    disabled
    class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-zinc-900 transition focus:border-zinc-400 focus:outline-none focus:ring-0 disabled:opacity-50 sm:text-sm sm:leading-6 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
  />
  <button
    id="chat-send"
    type="button"
    data-client-text="send"
    disabled
    class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-zinc-700 active:scale-95 disabled:opacity-50 dark:bg-zinc-100 dark:text-zinc-900"
  >
    {lgettext(@locale, "Send")}
  </button>
</div>
