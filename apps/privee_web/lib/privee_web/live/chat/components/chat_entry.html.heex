<%!-- The whole bubble stays hidden until the message is decrypted --%>
<div
  class={[
    "chat has-[[data-converted=false]]:hidden",
    case {@message.in_thread, @message.from == @current_session.id} do
      {true, true} -> "mr-3"
      {true, _} -> "ml-3"
      {_, true} -> "chat-end"
      {_, _} -> "chat-start"
    end
  ]}
  dir={if @message.from == @current_session.id && @message.in_thread, do: "rtl", else: "ltr"}
>
  <div class={[
    "chat-bubble",
    if(@message.from == @current_session.id,
      do: "chat-bubble-neutral",
      else: "chat-bubble-primary"
    )
  ]}>
    <%!-- The ChatScreen hook decrypts `data-body` (or reads local history) into this element --%>
    <p
      id={"chat-message-#{@message.id}"}
      data-signal-message
      data-id={@message.id}
      data-seq={@message.seq}
      data-epoch={@message.epoch}
      data-type={@message.type}
      data-body={@message.body}
      data-direction={if @message.from == @current_session.id, do: "out", else: "in"}
      data-client-nonce={if @message.from == @current_session.id, do: @message.client_nonce}
      data-converted="false"
      class={[
        "text-sm text-left break-word w-max max-w-[calc(100vw-62px)] sm:max-w-[450px] font-normal hidden",
        "data-[locked=true]:break-all data-[locked=true]:line-clamp-3 data-[locked=true]:font-mono data-[locked=true]:text-xs",
        if(@message.from == @current_session.id, do: "text-zinc-50", else: "text-zinc-900")
      ]}
    >
      &lrm;
    </p>
  </div>
</div>
