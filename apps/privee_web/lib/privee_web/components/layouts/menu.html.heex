<div class="navbar bg-base-300 flex items-center justify-between">
  <div class="flex items-center gap-4">
    <.link id="logo-button" navigate={@navigate_to}>
      <div class="flex space-x-3">
        <img
          src={~p"/images/PriveeLogoSmall.webp"}
          class="invert dark:invert-0"
          width="36"
          height="36"
          alt={lgettext(@locale, "Privee logo")}
          aria-label={lgettext(@locale, "Privee logo")}
        />
        <strong class="text-lg text-zinc-900 dark:text-zinc-50 hidden sm:inline">Privee</strong>
      </div>
    </.link>
  </div>

  <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
    <a
      id="source-code-link"
      href={PriveeWeb.Instance.source_url()}
      target="_blank"
      rel="noopener noreferrer"
      class="text-zinc-900 dark:text-zinc-50 opacity-70 transition-opacity hover:opacity-100"
      aria-label={lgettext(@locale, "Source code (AGPL-3.0)")}
      title={lgettext(@locale, "Source code (AGPL-3.0)")}
    >
      <svg
        class="w-6 h-6"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m8 8-4 4 4 4m8 0 4-4-4-4m-2-3-4 14"
        />
      </svg>
    </a>

    <div
      id="language-settings"
      class="relative"
      phx-hook="Locale"
      data-locale={@locale}
      data-description={lgettext(@locale, "Chatting app with focus on privacy")}
      data-title-suffix={lgettext(@locale, "Privacy App")}
      data-texts={Jason.encode!(PriveeWeb.ClientTexts.translations(@locale))}
    >
      <button
        id="settings-toggle"
        type="button"
        class="rounded-lg p-2 text-zinc-900 transition hover:bg-zinc-200 dark:text-zinc-50 dark:hover:bg-zinc-700"
        aria-label={lgettext(@locale, "Settings")}
        aria-controls="settings-menu"
        phx-click={JS.toggle(to: "#settings-menu")}
      >
        {lgettext(@locale, "Settings")}
      </button>

      <div
        id="settings-menu"
        class="absolute right-0 top-full z-50 mt-2 hidden w-64 rounded-xl border border-zinc-200 bg-white p-4 shadow-xl dark:border-zinc-700 dark:bg-zinc-900"
        phx-click-away={JS.hide(to: "#settings-menu")}
        phx-window-keydown={JS.hide(to: "#settings-menu")}
        phx-key="Escape"
      >
        <.form for={to_form(%{"locale" => @locale})} id="language-form" phx-change="set_locale">
          <.input
            type="select"
            name="locale"
            id="language-select"
            value={@locale}
            label={lgettext(@locale, "Language")}
            options={PriveeWeb.Locale.languages()}
          />
        </.form>

        <div class="mt-4 flex items-center justify-between text-sm text-zinc-800 dark:text-zinc-100">
          <span>{lgettext(@locale, "Theme")}</span>
          <.button
            id="theme-toggle"
            data-theme-toggle="theme-toggle"
            aria-label={lgettext(@locale, "Switch theme")}
            class="cursor-pointer"
          >
            <svg
              id="theme-toggle-dark-icon"
              data-theme-selector="dark"
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>

            <svg
              id="theme-toggle-light-icon"
              data-theme-selector="light"
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                fill-rule="evenodd"
                clip-rule="evenodd"
              >
              </path>
            </svg>
          </.button>
        </div>
      </div>
    </div>

    <%= if @current_session do %>
      <.button_link
        id="copy-session-code-btn"
        data-session-name={@current_session.session_name}
        data-action="code"
        aria-label={lgettext(@locale, "Copy session name")}
        legend={lgettext(@locale, "Copy session name")}
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 8v3a1 1 0 0 1-1 1H5m11 4h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v1m4 3v10a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7.13a1 1 0 0 1 .24-.65L7.7 8.35A1 1 0 0 1 8.46 8H13a1 1 0 0 1 1 1Z"
          />
        </svg>
      </.button_link>

      <.button_link
        id="copy-session-url-btn"
        data-session-name={@current_session.session_name}
        data-action="url"
        aria-label={lgettext(@locale, "Copy link")}
        legend={lgettext(@locale, "Copy link")}
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13.213 9.787a3.391 3.391 0 0 0-4.795 0l-3.425 3.426a3.39 3.39 0 0 0 4.795 4.794l.321-.304m-.321-4.49a3.39 3.39 0 0 0 4.795 0l3.424-3.426a3.39 3.39 0 0 0-4.794-4.795l-1.028.961"
          />
        </svg>
      </.button_link>

      <.button_link
        id="log-out-link"
        href={~p"/sessions/log_out"}
        method="delete"
        data-own-session-id={@current_session.id}
        class="cursor-pointer"
        legend={lgettext(@locale, "Log Out")}
        aria-label={lgettext(@locale, "Log Out")}
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20 12H8m12 0-4 4m4-4-4-4M9 4H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h2"
          />
        </svg>
      </.button_link>
    <% else %>
      <.button_link
        navigate={~p"/"}
        class="cursor-pointer"
        legend={lgettext(@locale, "Create")}
        aria-label={lgettext(@locale, "Create")}
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 12h14m-7 7V5"
          />
        </svg>
      </.button_link>

      <.button_link
        navigate={~p"/login"}
        class="cursor-pointer"
        legend={lgettext(@locale, "Sign in")}
        aria-label={lgettext(@locale, "Sign in")}
      >
        <svg
          class="w-6 h-6"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 12H4m12 0-4 4m4-4-4-4m3-4h2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-2"
          />
        </svg>
      </.button_link>
    <% end %>
  </div>
</div>
