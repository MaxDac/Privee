msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "A quick session needs no recovery phrase. You can sign in only once; you will not be able to recover this session later."
msgstr "Una sesión rápida no necesita frase de recuperación. Solo puedes iniciar sesión una vez; no podrás recuperarla más adelante."

msgid "Accept new security code"
msgstr "Aceptar nuevo código de seguridad"

msgid "Actions"
msgstr "Acciones"

msgid "Attempting to reconnect"
msgstr "Intentando reconectar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Chat commands"
msgstr "Comandos del chat"

msgid "Chatting app with focus on privacy"
msgstr "Aplicación de chat centrada en la privacidad"

msgid "Clear history on this device"
msgstr "Borrar historial en este dispositivo"

msgid "Close"
msgstr "Cerrar"

msgid "Compare the safety number with your contact to make sure nobody is in the middle."
msgstr "Compara el número de seguridad con tu contacto para asegurarte de que nadie está en medio."

msgid "Compare this number with your contact, in person or over another channel. If it matches, the conversation is end-to-end encrypted."
msgstr "Compara este número con tu contacto, en persona o por otro canal. Si coincide, la conversación está cifrada de extremo a extremo."

msgid "Conversations on this browser"
msgstr "Conversaciones en este navegador"

msgid "Copy link"
msgstr "Copiar enlace"

msgid "Copy session name"
msgstr "Copiar nombre de sesión"

msgid "Copy your session name or your chat link from the top bar and send it to your contact."
msgstr "Copia el nombre de tu sesión o el enlace del chat desde la barra superior y envíaselo a tu contacto."

msgid "Could not copy to the clipboard."
msgstr "No se ha podido copiar al portapapeles."

msgid "Create"
msgstr "Crear"

msgid "Create a new Privee"
msgstr "Crear un nuevo Privee"

msgid "Create a new one"
msgstr "Crear una nueva"

msgid "Create a new session"
msgstr "Crear una nueva sesión"

msgid "Create a session quickly without a recovery phrase"
msgstr "Crea una sesión rápidamente sin frase de recuperación"

msgid "Create a session to get a session name and a recovery phrase. The session name is how others reach you; the recovery phrase is your password."
msgstr "Crea una sesión para obtener un nombre de sesión y una frase de recuperación. El nombre de sesión es cómo te encuentran los demás; la frase de recuperación es tu contraseña."

msgid "Create an account"
msgstr "Crear una cuenta"

msgid "Creating account..."
msgstr "Creando cuenta..."

msgid "Creating..."
msgstr "Creando..."

msgid "Delete all encryption keys and history of this session from this device? You will need to reset encryption to chat again."
msgstr "¿Eliminar todas las claves de cifrado y el historial de esta sesión de este dispositivo? Tendrás que restablecer el cifrado para volver a chatear."

msgid "Delete the history on this device"
msgstr "Eliminar el historial en este dispositivo"

msgid "Delete the local history of this conversation from this device?"
msgstr "¿Eliminar el historial local de esta conversación de este dispositivo?"

msgid "Don't have a session?"
msgstr "¿No tienes una sesión?"

msgid "Don't use their name. Anyone with access to this browser can read hints."
msgstr "No uses su nombre. Cualquiera con acceso a este navegador puede leer las pistas."

msgid "Download this conversation as CSV"
msgstr "Descargar esta conversación en CSV"

msgid "Earlier on this device"
msgstr "Anteriormente en este dispositivo"

msgid "Edit the hint for this contact"
msgstr "Editar la pista de este contacto"

msgid "Encryption could not be initialized. Please reload the page."
msgstr "No se ha podido inicializar el cifrado. Recarga la página."

msgid "Encryption for this session was reset on another device, so this device can no longer send or receive messages."
msgstr "El cifrado de esta sesión se ha restablecido en otro dispositivo, por lo que este dispositivo ya no puede enviar ni recibir mensajes."

msgid "Error!"
msgstr "¡Error!"

msgid "Exchange a message first to compare safety numbers."
msgstr "Intercambia un mensaje primero para comparar los números de seguridad."

msgid "Export CSV"
msgstr "Exportar CSV"

msgid "Forget this device"
msgstr "Olvidar este dispositivo"

msgid "Guide"
msgstr "Guía"

msgid "Hang in there while we get back on track"
msgstr "Espera mientras restablecemos el servicio"

msgid "Hide the messages behind a password"
msgstr "Ocultar los mensajes tras una contraseña"

msgid "Hint"
msgstr "Pista"

msgid "Hint (only on this browser)"
msgstr "Pista (solo en este navegador)"

msgid "History"
msgstr "Historial"

msgid "How Privee works"
msgstr "Cómo funciona Privee"

msgid "Information"
msgstr "Información"

msgid "Internal Server Error"
msgstr "Error interno del servidor"

msgid "Invalid recovery phrase or session name"
msgstr "Frase de recuperación o nombre de sesión no válidos"

msgid "Keep me logged in"
msgstr "Mantener la sesión iniciada"

msgid "Language"
msgstr "Idioma"

msgid "Log Out"
msgstr "Cerrar sesión"

msgid "Logged out successfully."
msgstr "Sesión cerrada correctamente."

msgid "Message"
msgstr "Mensaje"

msgid "Messages are end-to-end encrypted in your browser with the Signal Protocol. The server only relays encrypted text it cannot read, and deletes it after a while."
msgstr "Los mensajes se cifran de extremo a extremo en tu navegador con el protocolo Signal. El servidor solo retransmite texto cifrado que no puede leer y lo borra al cabo de un tiempo."

msgid "Messages are hidden. Type :unlock followed by your password to show them."
msgstr "Los mensajes están ocultos. Escribe :unlock seguido de tu contraseña para mostrarlos."

msgid "Messages support **bold**, *italic*, ~~strikethrough~~, `code` and links."
msgstr "Los mensajes admiten **negrita**, *cursiva*, ~~tachado~~, `código` y enlaces."

msgid "New message received"
msgstr "Nuevo mensaje recibido"

msgid "Not Found"
msgstr "Página no encontrada"

msgid "Oops, something went wrong! Please check the errors below."
msgstr "¡Algo ha salido mal! Revisa los errores de abajo."

msgid "Open a chat"
msgstr "Abrir un chat"

msgid "Privacy App"
msgstr "Aplicación de privacidad"

msgid "Privee - Text received"
msgstr "Privee - Mensaje recibido"

msgid "Privee is a chat for private conversations that leave no trace: no account, no email, no phone number."
msgstr "Privee es un chat para conversaciones privadas que no dejan rastro: sin cuenta, sin correo, sin número de teléfono."

msgid "Privee logo"
msgstr "Logotipo de Privee"

msgid "Quick session"
msgstr "Sesión rápida"

msgid "Recovery phrase"
msgstr "Frase de recuperación"

msgid "Remove hint"
msgstr "Quitar pista"

msgid "Reset encryption identity"
msgstr "Restablecer identidad de cifrado"

msgid "Reset the encryption identity of this session? Your contacts will be asked to verify your new safety number."
msgstr "¿Restablecer la identidad de cifrado de esta sesión? Se pedirá a tus contactos que verifiquen tu nuevo número de seguridad."

msgid "Safety number"
msgstr "Número de seguridad"

msgid "Save"
msgstr "Guardar"

msgid "Send"
msgstr "Enviar"

msgid "Sent from another device."
msgstr "Enviado desde otro dispositivo."

msgid "Session Name"
msgstr "Nombre de sesión"

msgid "Session copied"
msgstr "Sesión copiada"

msgid "Session created successfully! Your session name has been automatically copied to the clipboard."
msgstr "¡Sesión creada! El nombre de sesión se ha copiado automáticamente al portapapeles."

msgid "Sessions instead of accounts"
msgstr "Sesiones en lugar de cuentas"

msgid "Settings"
msgstr "Ajustes"

msgid "Show the hidden messages again"
msgstr "Volver a mostrar los mensajes ocultos"

msgid "Show the safety number"
msgstr "Mostrar el número de seguridad"

msgid "Sign in"
msgstr "Iniciar sesión"

msgid "Sign in to existing session"
msgstr "Iniciar sesión en una sesión existente"

msgid "Signing in..."
msgstr "Iniciando sesión..."

msgid "Something went wrong!"
msgstr "¡Algo ha salido mal!"

msgid "Source code (AGPL-3.0)"
msgstr "Código fuente (AGPL-3.0)"

msgid "Specify the session name you would like to chat with."
msgstr "Indica el nombre de la sesión con la que quieres chatear."

msgid "Start Privee"
msgstr "Iniciar Privee"

msgid "Starting a conversation"
msgstr "Empezar una conversación"

msgid "Stored only on this browser. Hints are never sent to the server."
msgstr "Guardadas solo en este navegador. Las pistas nunca se envían al servidor."

msgid "Success!"
msgstr "¡Éxito!"

msgid "Switch theme"
msgstr "Cambiar tema"

msgid "The application was updated. Please reload the page."
msgstr "La aplicación se ha actualizado. Recarga la página."

msgid "The message could not be delivered yet. It will be sent automatically."
msgstr "El mensaje aún no se ha podido entregar. Se enviará automáticamente."

msgid "The message could not be sent. Please try again."
msgstr "No se ha podido enviar el mensaje. Inténtalo de nuevo."

msgid "The session name you'd like to contact."
msgstr "El nombre de la sesión que quieres contactar."

msgid "The session you're trying to join doesn't exist."
msgstr "La sesión a la que intentas unirte no existe."

msgid "Theme"
msgstr "Tema"

msgid "There is no history on the server. Messages you read are kept only on this browser, and a new device starts with an empty conversation. You can export them as CSV or delete them at any time."
msgstr "No hay historial en el servidor. Los mensajes que lees se guardan solo en este navegador y un dispositivo nuevo empieza con una conversación vacía. Puedes exportarlos en CSV o borrarlos en cualquier momento."

msgid "This browser does not support notifications."
msgstr "Este navegador no admite notificaciones."

msgid "This browser does not support the features required for end-to-end encryption (Web Locks). Please use an up-to-date browser."
msgstr "Este navegador no admite las funciones necesarias para el cifrado de extremo a extremo (Web Locks). Usa un navegador actualizado."

msgid "This device has no encryption keys for this session. Reset the encryption identity to continue; messages sent to your previous device will not be readable here."
msgstr "Este dispositivo no tiene claves de cifrado para esta sesión. Restablece la identidad de cifrado para continuar; los mensajes enviados a tu dispositivo anterior no se podrán leer aquí."

msgid "This language is not supported."
msgstr "Este idioma no es compatible."

msgid "This message could not be decrypted."
msgstr "No se ha podido descifrar este mensaje."

msgid "To register a session, choose a session name of at least 24 alphanumeric characters separated by hyphens, and a recovery phrase containing only letters, spaces and punctuation."
msgstr "Para registrar una sesión, elige un nombre de al menos 24 caracteres alfanuméricos separados por guiones y una frase de recuperación que contenga solo letras, espacios y puntuación."

msgid "To sign in again, use the session name and the recovery phrase. Keep the phrase safe: it cannot be recovered."
msgstr "Para volver a entrar, usa el nombre de sesión y la frase de recuperación. Guarda la frase en un lugar seguro: no se puede recuperar."

msgid "Turn VIM mode on or off"
msgstr "Activar o desactivar el modo VIM"

msgid "Type : in the message box to see the commands. They run in your browser and are never sent."
msgstr "Escribe : en el cuadro de mensaje para ver los comandos. Se ejecutan en tu navegador y nunca se envían."

msgid "Type a password after :lock, for example :lock my-secret."
msgstr "Escribe una contraseña después de :lock, por ejemplo :lock mi-secreto."

msgid "Unused sessions are deleted automatically, so nothing ties you to past conversations."
msgstr "Las sesiones sin usar se borran automáticamente, así que nada te vincula a conversaciones pasadas."

msgid "Url copied"
msgstr "Enlace copiado"

msgid "Want to reconnect with an existing session?"
msgstr "¿Quieres reconectar con una sesión existente?"

msgid "Warning!"
msgstr "¡Advertencia!"

msgid "We can't find the internet"
msgstr "No hay conexión a Internet"

msgid "Welcome back!"
msgstr "¡Bienvenido de nuevo!"

msgid "What's this?"
msgstr "¿Qué es esto?"

msgid "Who is speaking?"
msgstr "¿Quién habla?"

msgid "Why Privee"
msgstr "Por qué Privee"

msgid "Write your message here"
msgstr "Escribe tu mensaje aquí"

msgid "Write your own session name"
msgstr "Escribe tu nombre de sesión"

msgid "Write your preferred citation. This will be used to recover the session, so keep it saved."
msgstr "Escribe tu cita preferida. Se usará para recuperar la sesión, así que guárdala."

msgid "Write your session name."
msgstr "Escribe tu nombre de sesión."

msgid "Wrong password. The messages stay hidden."
msgstr "Contraseña incorrecta. Los mensajes siguen ocultos."

msgid "You cannot open a chat with your own session."
msgstr "No puedes abrir un chat con tu propia sesión."

msgid "You have to select a session to continue"
msgstr "Debes seleccionar una sesión para continuar"

msgid "You must have a session to access this page."
msgstr "Debes tener una sesión para acceder a esta página."

msgid "Your citation."
msgstr "Tu cita."

msgid "Your contact has not set up encryption yet. Try again once they are online."
msgstr "Tu contacto aún no ha configurado el cifrado. Inténtalo cuando esté en línea."

msgid "Your contact opens the link, or types your session name on the chat selection page."
msgstr "Tu contacto abre el enlace o escribe tu nombre de sesión en la página de selección de chat."

msgid "Your contact's security code changed. They may have reset their device, or someone may be intercepting the conversation. Verify the safety number with them before continuing."
msgstr "El código de seguridad de tu contacto ha cambiado. Puede haber restablecido su dispositivo, o alguien podría estar interceptando la conversación. Verifica el número de seguridad con tu contacto antes de continuar."

msgid "Your language preference could not be saved."
msgstr "No se ha podido guardar tu preferencia de idioma."
