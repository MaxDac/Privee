msgid ""
msgstr ""
"Language: pt-PT\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "A quick session needs no recovery phrase. You can sign in only once; you will not be able to recover this session later."
msgstr "Uma sessão rápida não precisa de frase de recuperação. Só pode iniciar sessão uma vez; não poderá recuperar esta sessão mais tarde."

msgid "Accept new security code"
msgstr "Aceitar novo código de segurança"

msgid "Actions"
msgstr "Ações"

msgid "Attempting to reconnect"
msgstr "A tentar restabelecer a ligação"

msgid "Cancel"
msgstr "Cancelar"

msgid "Chat commands"
msgstr "Comandos do chat"

msgid "Chatting app with focus on privacy"
msgstr "Aplicação de conversas centrada na privacidade"

msgid "Clear history on this device"
msgstr "Limpar histórico neste dispositivo"

msgid "Close"
msgstr "Fechar"

msgid "Compare the safety number with your contact to make sure nobody is in the middle."
msgstr "Compare o número de segurança com o seu contacto para garantir que ninguém está no meio."

msgid "Compare this number with your contact, in person or over another channel. If it matches, the conversation is end-to-end encrypted."
msgstr "Compare este número com o seu contacto, pessoalmente ou por outro canal. Se corresponder, a conversa está encriptada ponto a ponto."

msgid "Conversations on this browser"
msgstr "Conversas neste navegador"

msgid "Copy link"
msgstr "Copiar ligação"

msgid "Copy session name"
msgstr "Copiar nome da sessão"

msgid "Copy your session name or your chat link from the top bar and send it to your contact."
msgstr "Copie o nome da sessão ou a ligação do chat na barra superior e envie-o ao seu contacto."

msgid "Could not copy to the clipboard."
msgstr "Não foi possível copiar para a área de transferência."

msgid "Create"
msgstr "Criar"

msgid "Create a new Privee"
msgstr "Criar um novo Privee"

msgid "Create a new one"
msgstr "Criar uma nova"

msgid "Create a new session"
msgstr "Criar uma nova sessão"

msgid "Create a session quickly without a recovery phrase"
msgstr "Criar rapidamente uma sessão sem frase de recuperação"

msgid "Create a session to get a session name and a recovery phrase. The session name is how others reach you; the recovery phrase is your password."
msgstr "Crie uma sessão para obter um nome de sessão e uma frase de recuperação. O nome da sessão é como os outros o contactam; a frase de recuperação é a sua palavra-passe."

msgid "Create an account"
msgstr "Criar uma conta"

msgid "Creating account..."
msgstr "A criar a conta..."

msgid "Creating..."
msgstr "A criar..."

msgid "Delete all encryption keys and history of this session from this device? You will need to reset encryption to chat again."
msgstr "Eliminar todas as chaves de encriptação e o histórico desta sessão deste dispositivo? Terá de repor a encriptação para voltar a conversar."

msgid "Delete the history on this device"
msgstr "Eliminar o histórico neste dispositivo"

msgid "Delete the local history of this conversation from this device?"
msgstr "Eliminar o histórico local desta conversa deste dispositivo?"

msgid "Don't have a session?"
msgstr "Não tem uma sessão?"

msgid "Don't use their name. Anyone with access to this browser can read hints."
msgstr "Não use o nome da pessoa. Qualquer pessoa com acesso a este navegador pode ler as pistas."

msgid "Download this conversation as CSV"
msgstr "Transferir esta conversa em CSV"

msgid "Earlier on this device"
msgstr "Anteriormente neste dispositivo"

msgid "Edit the hint for this contact"
msgstr "Editar a dica para este contacto"

msgid "Encryption could not be initialized. Please reload the page."
msgstr "Não foi possível inicializar a encriptação. Recarregue a página."

msgid "Encryption for this session was reset on another device, so this device can no longer send or receive messages."
msgstr "A encriptação desta sessão foi reposta noutro dispositivo, pelo que este dispositivo já não pode enviar nem receber mensagens."

msgid "Error!"
msgstr "Erro!"

msgid "Exchange a message first to compare safety numbers."
msgstr "Troque primeiro uma mensagem para comparar os números de segurança."

msgid "Export CSV"
msgstr "Exportar CSV"

msgid "Forget this device"
msgstr "Esquecer este dispositivo"

msgid "Guide"
msgstr "Guia"

msgid "Hang in there while we get back on track"
msgstr "Aguarde enquanto repomos o serviço"

msgid "Hide the messages behind a password"
msgstr "Ocultar as mensagens com uma palavra-passe"

msgid "Hint"
msgstr "Pista"

msgid "Hint (only on this browser)"
msgstr "Pista (apenas neste navegador)"

msgid "History"
msgstr "Histórico"

msgid "How Privee works"
msgstr "Como funciona o Privee"

msgid "Information"
msgstr "Informações"

msgid "Internal Server Error"
msgstr "Erro interno do servidor"

msgid "Invalid recovery phrase or session name"
msgstr "Frase de recuperação ou nome da sessão inválidos"

msgid "Keep me logged in"
msgstr "Manter a sessão iniciada"

msgid "Language"
msgstr "Idioma"

msgid "Log Out"
msgstr "Terminar sessão"

msgid "Logged out successfully."
msgstr "Sessão terminada com sucesso."

msgid "Message"
msgstr "Mensagem"

msgid "Messages are end-to-end encrypted in your browser with the Signal Protocol. The server only relays encrypted text it cannot read, and deletes it after a while."
msgstr "As mensagens são cifradas ponto a ponto no seu navegador com o protocolo Signal. O servidor apenas reencaminha texto cifrado que não consegue ler e apaga-o passado algum tempo."

msgid "Messages are hidden. Type :unlock followed by your password to show them."
msgstr "As mensagens estão ocultas. Escreva :unlock seguido da palavra-passe para as mostrar."

msgid "Messages support **bold**, *italic*, ~~strikethrough~~, `code` and links."
msgstr "As mensagens suportam **negrito**, *itálico*, ~~rasurado~~, `código` e ligações."

msgid "New message received"
msgstr "Nova mensagem recebida"

msgid "Not Found"
msgstr "Página não encontrada"

msgid "Oops, something went wrong! Please check the errors below."
msgstr "Ocorreu um problema! Verifique os erros abaixo."

msgid "Open a chat"
msgstr "Abrir um chat"

msgid "Privacy App"
msgstr "Aplicação de privacidade"

msgid "Privee - Text received"
msgstr "Privee - Mensagem recebida"

msgid "Privee is a chat for private conversations: no account, no email, no phone number, and the server only relays encrypted messages."
msgstr "O Privee é um chat para conversas privadas: sem conta, sem email, sem número de telefone, e o servidor apenas reencaminha mensagens cifradas."

msgid "Privee logo"
msgstr "Logótipo do Privee"

msgid "Quick session"
msgstr "Sessão rápida"

msgid "Recovery phrase"
msgstr "Frase de recuperação"

msgid "Remove hint"
msgstr "Remover pista"

msgid "Reset encryption identity"
msgstr "Repor identidade de encriptação"

msgid "Reset the encryption identity of this session? Your contacts will be asked to verify your new safety number."
msgstr "Repor a identidade de encriptação desta sessão? Será pedido aos seus contactos que verifiquem o novo número de segurança."

msgid "Safety number"
msgstr "Número de segurança"

msgid "Save"
msgstr "Guardar"

msgid "Send"
msgstr "Enviar"

msgid "Sent from another device."
msgstr "Enviada de outro dispositivo."

msgid "Session Name"
msgstr "Nome da sessão"

msgid "Session copied"
msgstr "Sessão copiada"

msgid "Session created successfully! Your session name has been automatically copied to the clipboard."
msgstr "Sessão criada com sucesso! O nome da sessão foi copiado automaticamente para a área de transferência."

msgid "Sessions instead of accounts"
msgstr "Sessões em vez de contas"

msgid "Settings"
msgstr "Definições"

msgid "Show the hidden messages again"
msgstr "Mostrar novamente as mensagens ocultas"

msgid "Show the safety number"
msgstr "Mostrar o número de segurança"

msgid "Sign in"
msgstr "Iniciar sessão"

msgid "Sign in to existing session"
msgstr "Iniciar sessão numa sessão existente"

msgid "Signing in..."
msgstr "A iniciar sessão..."

msgid "Something went wrong!"
msgstr "Ocorreu um problema!"

msgid "Source code (AGPL-3.0)"
msgstr "Código-fonte (AGPL-3.0)"

msgid "Specify the session name you would like to chat with."
msgstr "Indique o nome da sessão com que pretende conversar."

msgid "Start Privee"
msgstr "Iniciar Privee"

msgid "Starting a conversation"
msgstr "Iniciar uma conversa"

msgid "Stored only on this browser. Hints are never sent to the server."
msgstr "Guardadas apenas neste navegador. As pistas nunca são enviadas para o servidor."

msgid "Success!"
msgstr "Sucesso!"

msgid "Switch theme"
msgstr "Mudar tema"

msgid "The CSV file is not encrypted and stays in your downloads, even after you sign out or clear this device. Download it?"
msgstr "O ficheiro CSV não está cifrado e fica nas suas transferências, mesmo depois de terminar a sessão ou limpar este dispositivo. Transferi-lo?"

msgid "The application was updated. Please reload the page."
msgstr "A aplicação foi atualizada. Recarregue a página."

msgid "The message could not be delivered yet. It will be sent automatically."
msgstr "A mensagem ainda não foi entregue. Será enviada automaticamente."

msgid "The message could not be sent. Please try again."
msgstr "Não foi possível enviar a mensagem. Tente novamente."

msgid "The session name you'd like to contact."
msgstr "O nome da sessão que pretende contactar."

msgid "The session you're trying to join doesn't exist."
msgstr "A sessão a que pretende juntar-se não existe."

msgid "Theme"
msgstr "Tema"

msgid "There is no history on the server. Messages you read are kept only on this browser, and a new device starts with an empty conversation. You can export them as CSV or delete them at any time."
msgstr "Não há histórico no servidor. As mensagens que lê ficam apenas neste navegador, e um novo dispositivo começa com uma conversa vazia. Pode exportá-las em CSV ou apagá-las a qualquer momento."

msgid "This browser does not support notifications."
msgstr "Este navegador não suporta notificações."

msgid "This browser does not support the features required for end-to-end encryption (Web Locks). Please use an up-to-date browser."
msgstr "Este navegador não suporta as funcionalidades necessárias para a encriptação ponto a ponto (Web Locks). Utilize um navegador atualizado."

msgid "This device has no encryption keys for this session. Reset the encryption identity to continue; messages sent to your previous device will not be readable here."
msgstr "Este dispositivo não tem chaves de encriptação para esta sessão. Reponha a identidade de encriptação para continuar; as mensagens enviadas para o dispositivo anterior não poderão ser lidas aqui."

msgid "This language is not supported."
msgstr "Este idioma não é suportado."

msgid "This message could not be decrypted."
msgstr "Não foi possível desencriptar esta mensagem."

msgid "To register a session, choose a session name of at least 24 alphanumeric characters separated by hyphens, and a recovery phrase containing only letters, spaces and punctuation."
msgstr "Para registar uma sessão, escolha um nome com pelo menos 24 caracteres alfanuméricos separados por hífen e uma frase de recuperação que contenha apenas letras, espaços e pontuação."

msgid "To sign in again, use the session name and the recovery phrase. Keep the phrase safe: it cannot be recovered."
msgstr "Para voltar a entrar, use o nome da sessão e a frase de recuperação. Guarde a frase em segurança: não pode ser recuperada."

msgid "Turn VIM mode on or off"
msgstr "Ativar ou desativar o modo VIM"

msgid "Type : in the message box to see the commands. They run in your browser and are never sent."
msgstr "Escreva : na caixa de mensagem para ver os comandos. São executados no seu navegador e nunca são enviados."

msgid "Type a password after :lock, for example :lock my-secret."
msgstr "Escreva uma palavra-passe depois de :lock, por exemplo :lock meu-segredo."

msgid "Unknown command. Start with :: to send a message that begins with a colon."
msgstr "Comando desconhecido. Comece com :: para enviar uma mensagem que comece com dois pontos."

msgid "Unused sessions are deleted from the server automatically after months without a sign-in."
msgstr "As sessões não utilizadas são apagadas automaticamente do servidor após meses sem início de sessão."

msgid "Url copied"
msgstr "Ligação copiada"

msgid "Want to reconnect with an existing session?"
msgstr "Quer voltar a ligar-se a uma sessão existente?"

msgid "Warning!"
msgstr "Aviso!"

msgid "We can't find the internet"
msgstr "Sem ligação à Internet"

msgid "Welcome back!"
msgstr "Bem-vindo de volta!"

msgid "What's this?"
msgstr "O que é isto?"

msgid "Who is speaking?"
msgstr "Quem está a falar?"

msgid "Why Privee"
msgstr "Porquê o Privee"

msgid "Write your message here"
msgstr "Escreva aqui a sua mensagem"

msgid "Write your own session name"
msgstr "Escreva o nome da sua sessão"

msgid "Write your preferred citation. This will be used to recover the session, so keep it saved."
msgstr "Escreva a sua citação preferida. Será usada para recuperar a sessão, por isso guarde-a."

msgid "Write your session name."
msgstr "Escreva o nome da sua sessão."

msgid "Wrong password. The messages stay hidden."
msgstr "Palavra-passe errada. As mensagens continuam ocultas."

msgid "You cannot open a chat with your own session."
msgstr "Não pode abrir um chat com a sua própria sessão."

msgid "You have to select a session to continue"
msgstr "Tem de selecionar uma sessão para continuar"

msgid "You must have a session to access this page."
msgstr "Tem de ter uma sessão para aceder a esta página."

msgid "Your citation."
msgstr "A sua citação."

msgid "Your contact has not set up encryption yet. Try again once they are online."
msgstr "O seu contacto ainda não configurou a encriptação. Tente novamente quando estiver online."

msgid "Your contact opens the link, or types your session name on the chat selection page."
msgstr "O seu contacto abre a ligação ou escreve o nome da sua sessão na página de seleção de chat."

msgid "Your contact's security code changed. They may have reset their device, or someone may be intercepting the conversation. Verify the safety number with them before continuing."
msgstr "O código de segurança do seu contacto mudou. Pode ter reposto o dispositivo, ou alguém pode estar a intercetar a conversa. Verifique o número de segurança com o contacto antes de continuar."

msgid "Your language preference could not be saved."
msgstr "Não foi possível guardar a sua preferência de idioma."
