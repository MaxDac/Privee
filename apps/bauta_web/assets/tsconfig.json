{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": ["../deps/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "Node",
    "module": "ES2020",
    "target": "ES2020",
    "checkJs": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.js", "**/*.mjs"],
  // Excluding tests as vitest is giving compilation errors
  "exclude": ["node_modules", "vendor/topbar.js", "js/tests"]
}
