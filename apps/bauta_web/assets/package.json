{
  "scripts": {
    "format": "prettier --write --config ./.prettierrc .",
    "check:dev": "npm run format && tsc && eslint --fix --ext .js,.mjs . && vitest run",
    "check": "prettier --check . && tsc && eslint --ext .js,.mjs . && npm test",
    "test": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest run --silent=true",
    "test:verbose": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest run --silent=false",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=\"--no-experimental-global-navigator\" vitest --silent=false"
  },
  "dependencies": {
    "daisyui": "^5.5.19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "~28.0.1",
    "@types/node": "~25.6.0",
    "@typescript-eslint/parser": "~8.59.1",
    "eslint": "~10.2.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-jsdoc": "~62.9.0",
    "eslint-plugin-prettier": "~5.5.5",
    "fake-indexeddb": "~6.2.5",
    "globals": "^17.5.0",
    "jsdom": "~29.1.0",
    "prettier": "~3.8.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
