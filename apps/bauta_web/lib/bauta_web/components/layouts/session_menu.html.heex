<ul
  tabindex="-1"
  class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 sm:w-96 p-2 shadow-xl"
>
  <li class="menu-title">
    <span>{@current_session.session_name}</span>
  </li>
  <li class="divider"></li>
  <li>
    <a
      id="copy-session-code-btn"
      data-session-name={@current_session.session_name}
      data-action="code"
      aria-label="copy-session-name"
    >
      <svg
        class="w-5 h-5 stroke-current"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 8v3a1 1 0 0 1-1 1H5m11 4h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v1m4 3v10a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7.13a1 1 0 0 1 .24-.65L7.7 8.35A1 1 0 0 1 8.46 8H13a1 1 0 0 1 1 1Z"
        />
      </svg>
      <span>Copy session name</span>
    </a>
  </li>
  <li>
    <a
      id="copy-session-url-btn"
      data-session-name={@current_session.session_name}
      data-action="url"
      aria-label="copy-session-url"
    >
      <svg
        class="w-5 h-5 stroke-current"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13.213 9.787a3.391 3.391 0 0 0-4.795 0l-3.425 3.426a3.39 3.39 0 0 0 4.795 4.794l-.321-.304m-.321-4.49a3.39 3.39 0 0 0 4.795 0l3.424-3.426a3.39 3.39 0 0 0-4.794-4.795l-1.028.961"
        />
      </svg>
      <span>Copy session URL</span>
    </a>
  </li>
  <li class="divider"></li>
  <li>
    <.link href={~p"/sessions/log_out"} method="delete">Sign out</.link>
  </li>
</ul>
