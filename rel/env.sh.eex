#!/bin/sh

# Determine deployment platform and configure accordingly
if [ -n "${FLY_APP_NAME}" ]; then
    # Fly.io specific configuration
    export ERL_AFLAGS="-proto_dist inet6_tcp"
    export ECTO_IPV6="true"
    export DNS_CLUSTER_QUERY="${FLY_APP_NAME}.internal"
    export RELEASE_DISTRIBUTION="name"
    export RELEASE_NODE="${FLY_APP_NAME}-${FLY_IMAGE_REF##*-}@${FLY_PRIVATE_IP}"
    echo "Configuring for Fly.io deployment"
elif [ -n "${KUBERNETES_SERVICE_HOST}" ]; then
    # Kubernetes/Azure AKS specific configuration
    export ERL_AFLAGS="-proto_dist inet_tcp"
    export ECTO_IPV6="false"
    export DNS_CLUSTER_QUERY="privee-app-svc-headless.default.svc.cluster.local"
    export RELEASE_DISTRIBUTION="name"
    # Use pod IP and release name for clustering
    export RELEASE_NODE="${RELEASE_NAME}@${RELEASE_IP}"
    echo "Configuring for Azure AKS deployment"
else
    # Default/local development configuration
    export ERL_AFLAGS="-proto_dist inet_tcp"
    export ECTO_IPV6="false"
    export RELEASE_DISTRIBUTION="sname"
    export RELEASE_NODE="${RELEASE_NAME:-privee}"
    echo "Using default configuration"
fi
