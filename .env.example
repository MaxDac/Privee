# Copy to .env and fill in. Used by docker-compose.yml (see docs/self-hosting.md).

# Public DNS name of your instance. Clients (web and the Android app) use
# https://<PHX_HOST> as the server address.
PHX_HOST=privee.example.org

# Generate with `mix phx.gen.secret` or `openssl rand -base64 48`.
SECRET_KEY_BASE=

# Password of the bundled PostgreSQL database.
POSTGRES_PASSWORD=

# Optional: display name reported by GET /api/app/info.
PRIVEE_INSTANCE_NAME=

# Source code of the version you run (AGPL-3.0, section 13).
# Point it to your fork if you changed the code.
PRIVEE_SOURCE_URL=https://github.com/MaxDac/Privee
